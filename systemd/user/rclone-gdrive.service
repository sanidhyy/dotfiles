[Unit]
Description=Rclone Mount Google Drive
ConditionPathIsDirectory=%h/Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount gdrive: %h/Drive \
--vfs-cache-mode full \
--vfs-cache-max-size 10G \
--vfs-cache-max-age 24h
ExecStop=%h/.local/bin/rclone-unmount-drive %h/Drive
ExecStopPost=/usr/bin/env bash -lc 'mountpoint -q %h/Drive && umount %h/Drive 2>/dev/null || true'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
