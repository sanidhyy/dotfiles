[Unit]
Description=Rclone Mount Google Drive
ConditionPathIsDirectory=%h/Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/rclone mount gdrive: %h/Drive \
--vfs-cache-mode full \
--vfs-cache-max-size 10G \
--vfs-cache-max-age 24h \
--systemd
ExecStop=/usr/bin/env bash -lc '\
  set -e; \
  target=%h/Drive; \
  mountpoint -q "$target" || exit 0; \
  if command -v fusermount3 >/dev/null 2>&1; then fusermount3 -u "$target"; else fusermount -u "$target"; fi \
'
ExecStopPost=/usr/bin/env bash -lc '\
  set +e; \
  target=%h/Drive; \
  mountpoint -q "$target" && umount "$target" 2>/dev/null || true \
'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
