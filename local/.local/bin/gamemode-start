#!/bin/bash

# Turn night light off and disable the laptop panel.

STATE="${XDG_RUNTIME_DIR:-/tmp}/gamemode.env"
[[ -f $STATE ]] && exit 0

ext=$(hyprctl monitors -j | jq -r '
  .[] | select(.disabled == false)
  | select(.name | test("^(eDP|LVDS|DSI)-") | not)
  | .name' | head -n1)

night=$(omarchy-toggle-nightlight-4500 --status)

[[ $(jq -r .enabled <<<"$night") == true ]] && omarchy-toggle-nightlight-4500
omarchy-hyprland-monitor-internal off || true

cat >"$STATE" <<EOF
ext=$ext
night_was_on=$(jq -r .enabled <<<"$night")
EOF
