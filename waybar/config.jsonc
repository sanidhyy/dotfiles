[
  // Main Bar
  {
    "include": [
      "~/.config/waybar/workspaces-active.jsonc"
    ],
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 26,
    "modules-left": [
      "cpu",
      "custom/gpu",
      "memory",
      "network"
    ],
    "modules-center": [
      "hyprland/workspaces",
      "custom/weather",
      "custom/privacydots",
      "custom/update",
      "custom/screenrecording-indicator"
    ],
    "modules-right": [
      "group/tray-expander",
      "custom/cava-player",
      "bluetooth",
      "pulseaudio",
      "battery",
      "clock"
    ],
    "custom/gpu": {
      "format": "<span color='#a6e3a1'>{icon}</span> {text}",
      "exec": "gpu-usage-waybar",
      "return-type": "json",
      "format-icons": "󰍹",
      "on-click": "omarchy-launch-or-focus-tui btop"
    },
    "custom/update": {
      "format": "",
      "exec": "omarchy-update-available",
      "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
      "tooltip-format": "Omarchy update available",
      "signal": 7,
      "interval": 21600
    },
    "cpu": {
      "interval": 3,
      "format": "<span color='#89b4fa'></span> {usage}%",
      "on-click": "omarchy-launch-or-focus-tui btop"
    },
    "memory": {
      "interval": 3,
      "format": "<span color='#cba6f7'></span> {percentage}%",
      "tooltip-format": "RAM usage: {used:0.1f}/{total:0.0f}GB",
      "on-click": "omarchy-launch-or-focus-tui btop"
    },
    "clock": {
      "format": "<span font_weight='900'></span> {:%H:%M}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "format": {
          "months": "<span color='#f9e2af'><b>{}</b></span>",
          "days": "<span color='#cdd6f4'><b>{}</b></span>",
          "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
          "weekdays": "<span color='#fab387'><b>{}</b></span>",
          "today": "<span color='#89b4fa'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },
    "custom/weather": {
      "exec": "$OMARCHY_PATH/default/waybar/weather.sh",
      "return-type": "json",
      "interval": 60,
      "tooltip": false,
      "on-click": "notify-send -u low \"$(omarchy-weather-status)\""
    },
    "network": {
      "format-icons": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "format": "<span color='#f38ba8'>{icon}</span> {bandwidthTotalBits}",
      "format-wifi": "<span color='#a6e3a1' ></span> {bandwidthDownBytes} <span color='#f38ba8'></span> {bandwidthUpBytes}",
      "format-ethernet": "<span color='#a6e3a1' ></span> {bandwidthDownBytes} <span color='#f38ba8'></span> {bandwidthUpBytes}",
      "format-disconnected": "󰤮",
      "tooltip-format-wifi": "{essid} ({frequency} GHz)",
      "tooltip-format-ethernet": "{ifname} Connected",
      "tooltip-format-disconnected": "Disconnected",
      "interval": 3,
      "spacing": 1,
      "on-click": "omarchy-launch-wifi"
    },
    "bluetooth": {
      "format": "<span color='#cba6f7'></span>",
      "format-off": "<span color='#cba6f7'>󰂲</span>",
      "format-disabled": "<span color='#cba6f7'>󰂲</span>",
      "format-connected": "<span color='#cba6f7'>󰂱</span>",
      "format-no-controller": "",
      "tooltip-format": "Devices connected: {num_connections}",
      "on-click": "omarchy-launch-bluetooth"
    },
    "pulseaudio": {
      "format": "<span color='#89b4fa'>{icon}</span> {volume}%",
      "on-click": "pamixer -t",
      "on-click-right": "omarchy-launch-audio",
      "tooltip-format": "{desc}",
      "scroll-step": 1,
      "max-volume": 130,
      "format-icons": {
        "alsa_output.usb-C-Media_Electronics_Inc._USB_Audio_Device-00.analog-stereo": "\udb80\udecb",
        "alsa_output.usb-C-Media_Electronics_Inc._USB_Audio_Device-00.analog-stereo-muted": "\udb81\udfce",
        "headphone": "\udb80\udecb",
        "headphone-muted": "\udb81\udfce",
        "headset": "\udb80\udecb",
        "headset-muted": "\udb81\udfce",
        "default": "",
        "default-muted": ""
      },
      "states": {
        "overdriven": 100
      }
    },
    "battery": {
      "format": "<span color='#fab387'>{icon}</span> {capacity}%",
      "format-discharging": "<span color='#fab387'>{icon}</span> {capacity}%",
      "format-charging": "<span color='#fab387'>{icon}</span> {capacity}%",
      "format-plugged": "",
      "format-icons": {
        "charging": [
          "󰢜",
          "󰂆",
          "󰂇",
          "󰂈",
          "󰢝",
          "󰂉",
          "󰢞",
          "󰂊",
          "󰂋",
          "󰂅"
        ],
        "default": [
          "󰁺",
          "󰁻",
          "󰁼",
          "󰁽",
          "󰁾",
          "󰁿",
          "󰂀",
          "󰂁",
          "󰂂",
          "󰁹"
        ]
      },
      "format-full": "󰂅",
      "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
      "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
      "interval": 5,
      "on-click": "omarchy-menu power",
      "states": {
        "warning": 20,
        "critical": 10
      }
    },
    "group/tray-expander": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 600,
        "children-class": "tray-group-item"
      },
      "modules": [
        "custom/expand-icon",
        "tray"
      ]
    },
    "custom/expand-icon": {
      "format": "",
      "tooltip": false,
      "on-scroll-up": "",
      "on-scroll-down": "",
      "on-scroll-left": "",
      "on-scroll-right": ""
    },
    "custom/screenrecording-indicator": {
      "on-click": "omarchy-capture-screenrecording",
      "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
      "signal": 8,
      "return-type": "json"
    },
    "custom/privacydots": {
      "exec": "~/.config/waybar/scripts/privacydots-stream.sh",
      "return-type": "json",
      "format": "{text}",
      "tooltip": true,
      "escape": false,
      "markup": "pango"
    },
    "custom/cava-player": {
      "format": "{}",
      "exec": "~/.config/waybar/scripts/playerinfo.sh",
      "return-type": "json",
      "escape": true,
      "tooltip": true,
      "interval": 2,
      "on-click": "playerctl play-pause"
    },
    "tray": {
      "icon-size": 12,
      "spacing": 17
    }
  },
  // Cava overlay
  {
    "reload_style_on_change": true,
    "name": "cava-overlay",
    "layer": "top",
    "exclusive": false,
    "passthrough": true,
    "height": 26,
    "margin-top": -26,
    "modules-right": [
      "custom/cava"
    ],
    "custom/cava": {
      "format": "{}",
      "exec": "~/.config/waybar/scripts/cava.sh",
      "tooltip": false
    }
  }
]