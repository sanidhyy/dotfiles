#!/bin/bash

# Toggle the external monitor on/off in Hyprland.
# Also switches Waybar layout (single/dual) and restores background selection.
# Dependencies: hyprctl, notify-send, omarchy-custom-waybar-swap, omarchy-custom-theme-bg-restore.

source ~/.config/omarchy-custom/constants/monitors.env

# Extract the connection type (e.g., HDMI, DP) from the monitor variable
port_type="${EXT_MONITOR%%-*}"

# Check if monitor is not plugged in using the dynamic port type
if ! grep -q "^connected$" /sys/class/drm/card*-${port_type}*/status 2>/dev/null; then
    notify-send -u normal "󰍹    No external monitor plugged in"
    exit 0
fi

if hyprctl monitors | grep -q "Monitor $EXT_MONITOR"; then
  hyprctl keyword monitor "$EXT_MONITOR,disable"
  notify-send -u low "󰍹    External display disabled"

  ~/.local/bin/omarchy-custom-waybar-swap single
  ~/.local/bin/omarchy-custom-theme-bg-restore
else
  hyprctl keyword monitor "$EXT_MONITOR,$EXT_MONITOR_MODE"
  notify-send -u low "󰍹    External display enabled"

  ~/.local/bin/omarchy-custom-waybar-swap dual
  ~/.local/bin/omarchy-custom-theme-bg-restore
fi
