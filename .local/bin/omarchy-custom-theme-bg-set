#!/bin/bash

# Set Omarchy theme background to an image/video path (supports mpvpaper for video).
# Writes selected path to cache and updates current background thumbnail/symlink.
# Usage: omarchy-custom-theme-bg-set <path-to-image-or-video>
# Example: omarchy-custom-theme-bg-set "$HOME/Pictures/wallpaper.mp4"

TARGET_FILE="$1"

stop_wallpaper() {
  local pattern=$1
  pkill -CONT -f "$pattern" 2>/dev/null || true
  pkill -TERM -f "$pattern" 2>/dev/null || true
  for _ in {1..20}; do
    pgrep -f "$pattern" >/dev/null || return 0
    sleep 0.1
  done
  pkill -KILL -f "$pattern" 2>/dev/null || true
}

if [[ $# -lt 1 || -z "${TARGET_FILE:-}" ]]; then
  echo "Usage: omarchy-custom-theme-bg-set <path-to-image-or-video>"
  echo "Example: omarchy-custom-theme-bg-set \"$HOME/Pictures/wallpaper.mp4\""
  exit 2
fi

if [[ ! -f "$TARGET_FILE" ]]; then
  echo "Target file not found: $TARGET_FILE"
  exit 1
fi

CACHE_DIR="$HOME/.cache/omarchy-custom/live_thumbs"
EXT_FILE="$HOME/.config/omarchy-custom/constants/video_exts.list"

mkdir -p "$CACHE_DIR"

filename=$(basename "$TARGET_FILE")
extension="${filename##*.}"
extension="${extension,,}"

exts=$(<"$EXT_FILE")
EXT_PATTERN="^(${exts//$'\n'/|})$"

echo "$TARGET_FILE" > "$HOME/.cache/omarchy-custom/background.file"

if [[ "$extension" =~ $EXT_PATTERN ]]; then
  stop_wallpaper "^/usr/bin/swaybg"
  stop_wallpaper "mpvpaper -p "

  setsid uwsm-app -- mpvpaper -p -o "no-audio loop-file=inf hwdec=auto-safe cache=no keepaspect=no" '*' "$TARGET_FILE" >/dev/null 2>&1 &

  STATIC_THUMB="$CACHE_DIR/${filename%.*}.jpg"

  if [[ ! -f "$STATIC_THUMB" ]]; then
    ffmpegthumbnailer -i "$TARGET_FILE" -o "$STATIC_THUMB" -s 320 -q 8 2>/dev/null
  fi

  ln -nsf "$STATIC_THUMB" "$HOME/.config/omarchy/current/background"
else
  stop_wallpaper "mpvpaper -p "

  omarchy-theme-bg-set "$TARGET_FILE"
fi
