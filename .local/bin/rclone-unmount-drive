#!/usr/bin/env bash

# Unmount a FUSE-mounted Drive directory (rclone mount).
# Prefers fusermount3 and falls back to fusermount; exits 0 if not mounted.
# Usage: rclone-unmount-drive [mount-path]
# Example: rclone-unmount-drive "$HOME/Drive"

set -euo pipefail

target="${1:-$HOME/Drive}"

if command -v mountpoint >/dev/null 2>&1; then
  mountpoint -q "$target" || exit 0
fi

if command -v fusermount3 >/dev/null 2>&1; then
  fusermount3 -u "$target"
else
  fusermount -u "$target"
fi
