#!/bin/bash

TARGET_FILE="$HOME/.config/omarchy/current/theme/walker.css"
INDICATOR="/* --- CUSTOM BORDERS --- */"

CUSTOM_CSS="
$INDICATOR
.search-container {
  border: 2px solid alpha(@foreground, 0.05);
  border-radius: 10px;
}

.box-wrapper {
  border-radius: 10px;
}

child {
  border-radius: 10px;
}
"

if ! grep -q "$INDICATOR" "$TARGET_FILE" 2>/dev/null; then
  echo -e "$CUSTOM_CSS" >> "$TARGET_FILE"
fi
