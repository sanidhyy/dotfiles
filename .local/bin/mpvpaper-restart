#!/bin/bash

if pidof hyprlock > /dev/null; then
  exit 0
fi

if gamemoded -s | grep -qw "active"; then
  exit 0
fi

HYPR_PID=$(pgrep -x Hyprland)

if [ -n "$HYPR_PID" ]; then
    export $(cat /proc/$HYPR_PID/environ | tr '\0' '\n' | grep -E '^(WAYLAND_DISPLAY|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS)=')
fi

if pgrep -x mpvpaper > /dev/null; then
    VID_PATH=$(pgrep -a mpvpaper | head -n 1 | awk '{print $NF}')
    
    pkill -x mpvpaper
    sleep 0.5
    
    if [ -n "$VID_PATH" ] && [ -f "$VID_PATH" ]; then
        ~/.local/bin/omarchy-custom-theme-bg-set "$VID_PATH"
    fi
fi
