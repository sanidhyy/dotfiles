#!/bin/bash

# Print a battery icon + percentage for Hyprlock.
# Exits silently if no battery is present.
# Reads: /sys/class/power_supply/BAT0.

if [ ! -d /sys/class/power_supply/BAT0 ]; then
    exit 0
fi

cap=$(cat /sys/class/power_supply/BAT0/capacity)
status=$(cat /sys/class/power_supply/BAT0/status)

if [ "$status" = "Charging" ] || [ "$status" = "Full" ]; then
    echo " $cap%"
    exit 0
fi

case $cap in
    100)    echo "󰂅 $cap%" ;;
    9[0-9]) echo "󰁹 $cap%" ;;
    8[0-9]) echo "󰂂 $cap%" ;;
    7[0-9]) echo "󰂁 $cap%" ;;
    6[0-9]) echo "󰂀 $cap%" ;;
    5[0-9]) echo "󰁿 $cap%" ;;
    4[0-9]) echo "󰁾 $cap%" ;;
    3[0-9]) echo "󰁽 $cap%" ;;
    2[0-9]) echo "󰁼 $cap%" ;;
    1[0-9]) echo "󰁻 $cap%" ;;
    [0-9])  echo "󰁺 $cap%" ;;
esac
