#!/usr/bin/env bash

# Output now-playing metadata as JSON for Waybar/Hyprlock.
# Prints nothing when nothing is playing.
# Dependencies: playerctl, jq.

# --- CONFIGURATION ---
# Maximum length for the song title before it gets truncated with "..."
MAX_LENGTH=40
# ---------------------

status=$(playerctl status 2>/dev/null) || exit 0
[ "$status" = "Playing" ] || exit 0

# Fetch all metadata in a single D-Bus call, separated by tabs.
# IFS ensures we split exactly on tabs, and read maps them to variables.
IFS=$'\t' read -r artist title album < <(
  playerctl metadata --format $'{{xesam:artist}}\t{{xesam:title}}\t{{xesam:album}}'
)

[ -n "$artist" ] && [ -n "$title" ] || exit 0

# Use jq to securely generate valid JSON, handle string truncation, and HTML-escape Pango characters
jq -n --compact-output \
  --arg artist "$artist" \
  --arg title "$title" \
  --arg album "$album" \
  --argjson max_len "$MAX_LENGTH" \
  '{
     text: (" " + (if ($title | length) > $max_len then ($title[0:$max_len-3] + "...") else $title end | @html)),
     tooltip: ("<span alpha=\"72%\">󰠃 Artist</span>   <span alpha=\"96%\">" + ($artist | @html) + "</span>\n<span alpha=\"72%\">󰀥 Album</span>    <span alpha=\"96%\">" + ($album | @html) + "</span>\n<span alpha=\"72%\"> Song</span>     <span alpha=\"96%\">" + ($title | @html) + "</span>")
   }'
