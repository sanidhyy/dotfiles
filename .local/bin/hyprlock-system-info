#!/bin/bash

# Print a one-line system summary for Hyprlock.
# Dependencies: omarchy-version.

user=$(whoami)
host=$(hostname)
omarchy=$(omarchy-version)
kernel=$(uname -r | sed 's/-.*$//')
uptime=$(awk '{if ($1<86400) print int($1/3600)" hours"; else print int($1/86400)" days"}' /proc/uptime)

echo "<span alpha=\"92%\">User: </span><span weight=\"bold\" alpha=\"92%\">$user</span>   <span alpha=\"92%\">Host: </span><span weight=\"bold\" alpha=\"92%\">$host</span>   <span alpha=\"92%\">Omarchy: </span><span weight=\"bold\" alpha=\"92%\">$omarchy</span>   <span alpha=\"92%\">Kernel: </span><span weight=\"bold\" alpha=\"92%\">$kernel</span>   <span alpha=\"92%\">Uptime: </span><span weight=\"bold\" alpha=\"92%\">$uptime</span>"
