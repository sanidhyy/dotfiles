#!/bin/bash

# Adjust brightness on the external DDC/CI monitor and show Omarchy OSD.
# Usage: omarchy-brightness-external <+ step | - step>
# Example: omarchy-brightness-external "+ 10"

step="$1"
cache_file="/tmp/brightness_cache"

if [ ! -f "$cache_file" ]; then
    current_brightness=$(ddcutil --display 1 getvcp 10 --terse | awk '{print $4}')
    echo "$current_brightness" > "$cache_file"
fi

current_brightness=$(cat "$cache_file")

new_brightness=$((current_brightness $step))

if [ "$new_brightness" -gt 100 ]; then
    new_brightness=100
elif [ "$new_brightness" -lt 0 ]; then
    new_brightness=0
fi

# 3. Save the new value to the cache
echo "$new_brightness" > "$cache_file"

omarchy-swayosd-brightness "$new_brightness"

ddcutil --display 1 --noverify --skip-ddc-checks --disable-dynamic-sleep --sleep-multiplier 0.1 --maxtries 1,1,1 setvcp 10 $new_brightness >/dev/null 2>&1 &
