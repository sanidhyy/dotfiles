#!/bin/bash

# Lock screen helper that supports video wallpapers (mpvpaper overlay).
# If the current background is a video, it makes Hyprlock background transparent
# and resumes the wallpaper after unlock.
# Dependencies: hyprlock, mpvpaper, hyprctl, bg-pause/bg-resume.

set -euo pipefail

if [[ "${OMARCHY_LOCK_ONLY:-false}" != "true" ]]; then
  (
    for _ in {1..5}; do
      pidof hyprlock >/dev/null && break
      sleep 1
    done

    sleep 3
    pkill -STOP -x mpvpaper >/dev/null 2>&1 || true

    # TODO: KBD brightness (Work in progress)
    omarchy-brightness-display off

    # New polling loop to catch manual wakes
    while pidof hyprlock >/dev/null; do
      if hyprctl monitors | grep -q "dpmsStatus: 1"; then
        ~/.local/bin/omarchy-custom-system-wake
        break
      fi

      sleep 0.4
    done
  ) &
fi

if pidof hyprlock > /dev/null; then
  exit 0
fi

MPV_PID=""
BG_PAUSED=0
BG_SNIPPET_SWAPPED=0

cleanup() {
  set +e

  if [[ -n "${MPV_PID:-}" ]] && kill -0 "$MPV_PID" >/dev/null 2>&1; then
    kill "$MPV_PID" >/dev/null 2>&1 || true
  fi

  if [[ "${BG_SNIPPET_SWAPPED:-0}" -eq 1 ]]; then
    ln -nsf "$HYPRLOCK_BG_NORMAL" "$HYPRLOCK_BG_ACTIVE" >/dev/null 2>&1 || true
  fi

  if [[ "${BG_PAUSED:-0}" -eq 1 ]]; then
    "$HOME/.local/bin/bg-resume" >/dev/null 2>&1 || true
  fi

  ~/.local/bin/omarchy-custom-system-wake
}
trap cleanup EXIT INT TERM

hyprctl switchxkblayout all 0 >/dev/null 2>&1 || true
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi
pkill -f org.omarchy.screensaver >/dev/null 2>&1 || true

BG_FILE="$HOME/.cache/omarchy-custom/background.file"
EXT_FILE="$HOME/.config/omarchy-custom/constants/video_exts.list"
HYPRLOCK_CONF="$HOME/.config/hypr/hyprlock.conf"
HYPRLOCK_BG_ACTIVE="$HOME/.config/hypr/hyprlock-background-active.conf"
HYPRLOCK_BG_NORMAL="$HOME/.config/hypr/hyprlock-background-normal.conf"
HYPRLOCK_BG_VIDEO="$HOME/.config/hypr/hyprlock-background-video.conf"

if [[ -f "$BG_FILE" ]]; then
  BG=$(cat "$BG_FILE")
  filename=$(basename "$BG")
  extension="${filename##*.}"
  EXT_PATTERN="^($(paste -sd '|' "$EXT_FILE"))$"

  if [[ "$extension" =~ $EXT_PATTERN ]]; then
    ln -nsf "$HYPRLOCK_BG_VIDEO" "$HYPRLOCK_BG_ACTIVE"
    BG_SNIPPET_SWAPPED=1

    "$HOME/.local/bin/bg-pause"
    BG_PAUSED=1

    mpvpaper -o "loop no-audio hwdec=auto keepaspect=no" -l overlay '*' "$BG" >/dev/null 2>&1 &
    
    sleep 0.5
    MPV_PID=$!

    hyprlock
    exit 0
  fi
fi

hyprlock
