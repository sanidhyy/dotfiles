#!/bin/bash

if pidof hyprlock > /dev/null; then
  exit 0
fi

hyprctl switchxkblayout all 0 > /dev/null 2>&1
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi
pkill -f org.omarchy.screensaver

BG_FILE="$HOME/.cache/omarchy-custom/background.file"
EXT_FILE="$HOME/.config/omarchy-custom/constants/video_exts.list"
HYPRLOCK_CONF="$HOME/.config/hypr/hyprlock.conf"
HYPRLOCK_TEMP_CONF="/tmp/hyprlock-video-${USER}.conf"

# Video
if [[ -f "$BG_FILE" ]]; then
  BG=$(cat "$BG_FILE")
  filename=$(basename "$BG")
  extension="${filename##*.}"
  EXT_PATTERN="^($(paste -sd '|' "$EXT_FILE"))$"

  if [[ "$extension" =~ $EXT_PATTERN ]]; then
    sed -e '/^[[:space:]]*#[[:space:]]*OMARCHY_CUSTOM_LOCK_VIDEO_BEGIN[[:space:]]*$/,/^[[:space:]]*#[[:space:]]*OMARCHY_CUSTOM_LOCK_VIDEO_END[[:space:]]*$/ { s/^[[:space:]]*path[[:space:]]*=.*/    # path removed (video wallpaper lock)/; s/^[[:space:]]*color[[:space:]]*=.*/    color = rgba(0, 0, 0, 0)/; }' \
        "$HYPRLOCK_CONF" > "$HYPRLOCK_TEMP_CONF"
    
    ~/.local/bin/bg-pause

    mpvpaper -o "loop no-audio hwdec=auto keepaspect=no" -l overlay '*' "$BG" >/dev/null 2>&1 &

    sleep 0.5

    MPV_PID=$!

    hyprlock --config "$HYPRLOCK_TEMP_CONF"

    kill $MPV_PID
    ~/.local/bin/bg-resume

    exit 0
  fi
fi

# Image
hyprlock
